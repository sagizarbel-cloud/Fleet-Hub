# Copy to .env and fill in, or run `pnpm env:init` to generate one. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# Database (dev: docker compose -f docker-compose.dev.yml up -d)
DATABASE_URL=postgresql://fleethub:fleethub@localhost:5432/fleethub
# Separate database used by `pnpm test` (it is wiped on every run)
DATABASE_URL_TEST=postgresql://fleethub:fleethub@localhost:5432/fleethub_test

# API
API_HOST=127.0.0.1
API_PORT=3001
# Public URL of the site. Writes from any other Origin are rejected; reset links use it.
APP_ORIGIN=http://localhost:5173
# Random 32+ byte secret for signing cookies: openssl rand -base64 32
SESSION_SECRET=

# 32-byte key, base64, for AES-256-GCM start-code encryption: openssl rand -base64 32
FLEET_CODE_KEY=

# Where uploaded files are stored (a volume in production)
UPLOAD_DIR=./uploads
# Maximum upload size in megabytes
UPLOAD_MAX_MB=20

# Password for the fake seed users (dev only)
SEED_PASSWORD=fleethub-dev

# Production uses deploy/.env instead (see deploy/.env.example and docs/RUNBOOK.md).
