# Copy to .env and fill in. Never commit .env.

# Database (dev: docker-compose.dev.yml)
DATABASE_URL=postgresql://fleethub:fleethub@localhost:5432/fleethub

# API
API_PORT=3001
# Public URL of the site, used for the Origin check and reset links
APP_ORIGIN=http://localhost:5173
# Random 32+ byte secret for signing session cookies: openssl rand -base64 32
SESSION_SECRET=

# 32-byte key, base64, for AES-256-GCM start-code encryption: openssl rand -base64 32
FLEET_CODE_KEY=

# Where uploaded files are stored (a volume in production)
UPLOAD_DIR=./uploads
# Maximum upload size in megabytes
UPLOAD_MAX_MB=20

# Production only (Phase 9)
DOMAIN=
