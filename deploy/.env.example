# Production settings for deploy/docker-compose.prod.yml. Create deploy/.env with
#   deploy/init-env.sh <domain>
# which fills in fresh secrets. Never commit deploy/.env.

# The site's address, without https:// (its DNS A record must point at this server)
DOMAIN=

# Random secrets (init-env.sh generates them; keep them safe, see docs/RUNBOOK.md)
POSTGRES_PASSWORD=
# Signs session cookies. Changing it signs everyone out.
SESSION_SECRET=
# Encrypts start codes (AES-256-GCM). Losing or changing it makes stored start codes unreadable.
FLEET_CODE_KEY=

# Largest upload in megabytes
UPLOAD_MAX_MB=20
# api log level: info, warn or error
LOG_LEVEL=info

# Lets `docker compose …` run from the deploy/ folder without -f
COMPOSE_FILE=docker-compose.prod.yml
