# Phase 1 check only: proves the api's native dependencies (Prisma engines, argon2)
# install and load on linux/arm64. The production Dockerfile comes in Phase 9.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/api/prisma apps/api/prisma
COPY apps/api/prisma.config.ts apps/api/
RUN pnpm install --frozen-lockfile --filter @fleet-hub/api...
WORKDIR /app/apps/api
RUN node -e "import('@node-rs/argon2').then(async (a) => { const h = await a.hash('x'); if (!(await a.verify(h, 'x'))) process.exit(1); console.log('argon2 ok on', process.arch); })" \
 && node -e "const { PrismaClient } = require('@prisma/client'); new PrismaClient(); console.log('prisma client ok on', process.arch);"
